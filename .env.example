# Copy to .env and edit. Compose reads this automatically.

# Required. Use something long; this guards your library.
ALBUMPLAYER_PASSWORD=change-me-to-something-long

# Absolute path to your music on the Docker host.
MUSIC_PATH=/mnt/mozek/Home/Music

# --- Only needed for docker-compose.tailscale.yml ---
# Auth key from https://login.tailscale.com/admin/settings/keys
# Make it reusable and NOT ephemeral, so the node survives a restart.
TS_AUTHKEY=tskey-auth-...
